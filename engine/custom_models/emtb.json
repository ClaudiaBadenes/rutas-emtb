// Perfil base eMTB: acceso legal para bici de montaña + velocidades con asistencia (máx. 25 km/h).
// Las preferencias por tipo de ruta, dificultad y zonas se añaden en cada petición desde el backend.
{
  "priority": [
    { "if": "true", "multiply_by": "mtb_priority" },
    { "if": "mtb_rating > 6", "multiply_by": "0" },
    { "if": "hike_rating > 4", "multiply_by": "0" },
    { "if": "!mtb_access && (!backward_mtb_access || roundabout)", "multiply_by": "0" },
    { "else_if": "!mtb_access && backward_mtb_access", "multiply_by": "0.2" },
    { "if": "bike_road_access == PRIVATE || bike_road_access == DESTINATION", "multiply_by": "0.1" },
    { "if": "road_class == PRIMARY", "multiply_by": "0.2" },
    { "if": "road_class == SECONDARY", "multiply_by": "0.5" }
  ],
  "speed": [
    { "if": "road_class == PATH || road_class == BRIDLEWAY || road_class == FOOTWAY", "limit_to": "13" },
    { "else_if": "road_class == TRACK", "limit_to": "18" },
    { "else": "", "limit_to": "22" },
    { "if": "mtb_rating > 3", "limit_to": "7" },
    { "else_if": "mtb_rating > 2", "limit_to": "10" },
    { "if": "average_slope >= 18", "limit_to": "6" },
    { "else_if": "average_slope >= 12", "multiply_by": "0.7" },
    { "else_if": "average_slope <= -12", "multiply_by": "0.8" }
  ]
}
